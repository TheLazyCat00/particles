package raylib;

import core$;

type Raylib = #handle{
	cType = "zane_raylib_t";
}

type Color = struct {
	r @primitives$U8;
	g @primitives$U8;
	b @primitives$U8;
	a @primitives$U8;
}

Color(
	r U8,
	g U8,
	b U8,
	a U8
) => init {
	r = @primitives$U8(r);
	g = @primitives$U8(g);
	b = @primitives$U8(b);
	a = @primitives$U8(a);
}

type Vec2 = struct {
	x I32;
	y I32;
}

Vec2(x I32, y I32) => init{x; y;}

// Foreign functions
@primitives$I64 _random(max @primitives$I64) foreign "zane_rl_random";

@primitives$Unit _initWindow(
	this Raylib,
	width @primitives$I32,
	height @primitives$I32,
	title @primitives$String
) mut foreign "zane_rl_init_window";

@primitives$Bool _windowShouldClose(
	this Raylib
) foreign "zane_rl_window_should_close";

@primitives$Unit _setTargetFPS(
	this Raylib,
	fps @primitives$I32
) mut foreign "zane_rl_set_target_fps";

@primitives$Unit _beginDrawing(
	this Raylib
) mut foreign "zane_rl_begin_drawing";

@primitives$Unit _clearBackground(
	this Raylib,
	color Color
) mut foreign "zane_rl_clear_background";

@primitives$Unit _drawText(
	this Raylib,
	text @primitives$String,
	x @primitives$I32,
	y @primitives$I32,
	size @primitives$I32,
	color Color
) mut foreign "zane_rl_draw_text";

@primitives$Unit _drawRect(
	this Raylib,
	x @primitives$I32,
	y @primitives$I32,
	width @primitives$I32,
	height @primitives$I32,
	color Color
) mut foreign "zane_rl_draw_rect";

@primitives$Unit _endDrawing(
	this Raylib
) mut foreign "zane_rl_end_drawing";

@primitives$Unit _closeWindow(
	this Raylib
) mut foreign "zane_rl_close_window";

// Public Zane methods
Int random(max Int) => Int(_random(max));

Unit initWindow(
	this Raylib,
	width I32,
	height I32,
	title String
) mut {
	this!_initWindow(width, height, title);
	return Unit();
}

Bool windowShouldClose(this Raylib) =>
	Bool(this:_windowShouldClose());

Unit setTargetFPS(this Raylib, fps I32) mut {
	this!_setTargetFPS(fps);
	return Unit();
}

Unit beginDrawing(this Raylib) mut {
	this!_beginDrawing();
	return Unit();
}

Unit clearBackground(
	this Raylib,
	color Color
) mut {
	this!_clearBackground(color);
	return Unit();
}

Unit drawText(
	this Raylib,
	text String,
	pos Vec2,
	size I32,
	color Color
) mut {
	this!_drawText(text, pos.x, pos.y, size, color);
	return Unit();
}

Unit drawRect(
	this Raylib,
	pos Vec2,
	dims Vec2,
	color Color
) mut {
	this!_drawRect(pos.x, pos.y, dims.x, dims.y, color);
	return Unit();
}

Unit endDrawing(this Raylib) mut {
	this!_endDrawing();
	return Unit();
}

Unit closeWindow(this Raylib) mut {
	this!_closeWindow();
	return Unit();
}
